{
  "name": "resume-toner",
  "version": "1.1.0",
  "description": "Local-first resume tailoring tools for reviewed, ATS-friendly exports.",
  "author": "Parth Dhroovji",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite --mode desktop --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173/desktop.html && electron desktop/main.cjs --dev\"",
    "desktop:build": "npm run desktop:build:win",
    "desktop:build:win": "tsc --noEmit && vite build --mode desktop && electron-builder --win nsis",
    "desktop:build:mac": "tsc --noEmit && vite build --mode desktop && electron-builder --mac --arm64 -c.forceCodeSigning=true",
    "desktop:preview": "tsc --noEmit && vite build --mode desktop && electron desktop/main.cjs",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "package": "npm run build && powershell -NoProfile -File scripts/package.ps1",
    "audit:release": "powershell -NoProfile -File scripts/audit-release.ps1"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.1",
    "dexie": "^4.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.parthdhroovji.resumetoner.desktop",
    "productName": "Resume Toner Desktop",
    "directories": {
      "buildResources": "build",
      "output": "desktop-release-1.1.0"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/platform.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "Developer ID Application",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Resume-Toner-Desktop-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
