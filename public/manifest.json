{
  "manifest_version": 3,
  "name": "Resume Toner",
  "version": "1.0.0",
  "description": "Tailor a technical resume to a job listing with your own Gemini API key.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "action": {
    "default_title": "Capture job for Resume Toner",
    "default_popup": "popup.html",
    "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}
